  "compositeCriteria": [
    {
      "id": "composite-contract-integrity",
      "family": "evaluator-integrity",
      "weight": 20,
      "hardGate": true,
      "evidenceInputs": ["docs/evals/composite-contract.json", "launch result manifest"],
      "passingCondition": "The versioned contract is internally valid and every required result ID, weight, hard-gate status, family, and evaluator evidence field is present.",
      "antiGamingRule": "Do not delete, rename, disable, or reweight a criterion to preserve a pass.",
      "stopCondition": "The observed result manifest exactly matches the frozen contract.",
      "manualGateId": null
    },
    {
      "id": "candidate-input-binding",
      "family": "candidate-identity",
      "weight": 20,
      "hardGate": true,
      "evidenceInputs": ["Git HEAD", "Git worktree state", "material repository files", "contract", "public citation registry", "evaluator implementation"],
      "passingCondition": "The report includes reproducible SHA-256 fingerprints for the candidate, contract, material inputs, evaluator, and public registry.",
      "antiGamingRule": "Do not certify a report produced for another commit, contract, input set, or public registry.",
      "stopCondition": "All fingerprints are present, well formed, and recompute from the current candidate.",
      "manualGateId": "independent-exact-candidate-holdout"
    },
    {
      "id": "provenance-frontier-closure",
      "family": "provenance-frontier",
      "weight": 20,
      "hardGate": true,
      "evidenceInputs": ["canonical knowledge bank", "citation pages", "publication decisions", "proof coverage"],
      "passingCondition": "Every public citation occurrence closes through an active canonical projection to an existing claim, source relationship, source record, selected publication decision, and allowed surface.",
      "antiGamingRule": "Do not satisfy closure by dropping a public occurrence, weakening citation requirements, or hiding an unresolved edge.",
      "stopCondition": "The canonical graph has no duplicate IDs, dangling references, unsupported public occurrence, or missing selected decision.",
      "manualGateId": null
    },
    {
      "id": "selective-projection-governance",
      "family": "selective-projection",
      "weight": 20,
      "hardGate": true,
      "evidenceInputs": ["claim maturity", "public-safety status", "editorial status", "publication decisions", "projection surfaces"],
      "passingCondition": "Selected public projections are explicitly authorized while reserve, hold, retired, protected, and rights-pending material remains off public routes.",
      "antiGamingRule": "No-silent-loss may not be implemented as automatic publication, and public defensibility may not be treated as editorial selection.",
      "stopCondition": "Every claim has a matching publication decision and no unselected or protected claim has an active public route.",
      "manualGateId": "visual-proof-rights-review"
    },
    {
      "id": "normalized-public-safety",
      "family": "privacy-and-rights",
      "weight": 20,
      "hardGate": true,
      "evidenceInputs": ["public application source", "public-safe knowledge-bank documents", "eval contracts and guidance"],
      "passingCondition": "Normalized and escape-decoded inspection finds no private local path, credential, token, key block, or unapproved phone-shaped value in governed public text.",
      "antiGamingRule": "Do not bypass scans with Unicode controls, encoded separators, Markdown aliases, escaped JSON, or test fixtures containing real secrets.",
      "stopCondition": "The governed public-text scan is empty and synthetic bypass fixtures are rejected.",
      "manualGateId": null
    }
  ]
