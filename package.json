{
  "name": "jamie-burkart-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=26 <27",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "npm run dev -w @jamie-burkart/www",
    "build": "npm run build -w @jamie-burkart/www",
    "start": "npm run start -w @jamie-burkart/www",
    "lint": "npm run lint -w @jamie-burkart/www",
    "typecheck": "npm run typecheck -w @jamie-burkart/www",
    "check": "npm run check:citations && npm run test:citations && npm run test:evals && npm run test:knowledge-lifecycle && npm run test:knowledge-history && npm run test:composite && npm run wiki:test && npm run test:hiring && npm run check:knowledge-history && npm run check -w @jamie-burkart/www && npm run knowledge-bank && npm run wiki:check && npm run evals:knowledge && npm run public-safety && npm run check:routes && npm run evals:application && npm run evals:composite && npm run evals:wiki && npm run check:hiring",
    "generate:citations": "node scripts/generate-public-citations.mjs",
    "check:citations": "node scripts/check-citations.mjs",
    "test:citations": "node --test scripts/tests/citations.test.mjs",
    "test:evals": "node --test scripts/tests/portfolio-evals.test.mjs",
    "test:knowledge-lifecycle": "node --test scripts/tests/knowledge-lifecycle.test.mjs",
    "test:knowledge-history": "node --test scripts/tests/knowledge-history.test.mjs",
    "test:composite": "node --test scripts/tests/composite-integration-evals.test.mjs",
    "evals:application": "node scripts/run-portfolio-evals.mjs --profile application_ready",
    "evals:production": "node scripts/run-portfolio-evals.mjs --profile production_ready",
    "evals:knowledge": "node scripts/run-knowledge-lifecycle-evals.mjs",
    "evals:composite": "node scripts/run-composite-integration-evals.mjs",
    "check:knowledge-history": "node scripts/check-knowledge-history.mjs",
    "record:knowledge": "node scripts/record-knowledge-event.mjs",
    "query:knowledge": "node scripts/query-knowledge-lifecycle.mjs",
    "wiki:graph": "node scripts/generate-knowledge-wiki.mjs",
    "wiki:report": "node scripts/generate-knowledge-wiki.mjs",
    "wiki:check": "node scripts/check-knowledge-wiki.mjs",
    "wiki:test": "node --test scripts/tests/knowledge-wiki.test.mjs",
    "wiki:tasks": "node scripts/run-knowledge-wiki-tasks.mjs",
    "wiki:query": "node scripts/query-knowledge-wiki.mjs",
    "evals:wiki": "node scripts/run-knowledge-wiki-evals.mjs",
    "test:hiring": "node --test scripts/tests/hiring-acceptance.test.mjs",
    "check:hiring": "node scripts/run-hiring-acceptance-evals.mjs --no-report",
    "evals:hiring": "node scripts/run-hiring-acceptance-evals.mjs",
    "report:citations": "node scripts/report-citations.mjs",
    "knowledge-bank": "node scripts/check-knowledge-bank.mjs",
    "public-safety": "node scripts/check-public-safety.mjs",
    "routes": "npm run check:routes",
    "check:routes": "node scripts/check-routes.mjs",
    "check:production": "npm run preflight:production",
    "preflight:staging": "APP_ENV=staging SITE_ENV=staging NEXT_PUBLIC_DEPLOY_ENV=staging SITE_URL=https://staging.jamieburk.art NEXT_PUBLIC_SITE_URL=https://staging.jamieburk.art NEXT_PUBLIC_ROBOTS_POLICY=noindex npm run check",
    "preflight:production": "APP_ENV=production SITE_ENV=production NEXT_PUBLIC_DEPLOY_ENV=production SITE_URL=https://jamieburk.art NEXT_PUBLIC_SITE_URL=https://jamieburk.art NEXT_PUBLIC_ROBOTS_POLICY=index npm run check"
  }
}
