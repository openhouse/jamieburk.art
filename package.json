{
  "name": "jamie-burkart-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=26 <27",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "npm run dev -w @jamie-burkart/www",
    "build": "npm run build -w @jamie-burkart/www",
    "start": "npm run start -w @jamie-burkart/www",
    "lint": "npm run lint -w @jamie-burkart/www",
    "typecheck": "npm run typecheck -w @jamie-burkart/www",
    "check": "npm run check:citations && npm run test:citations && npm run test:evals && npm run check:knowledge-lifecycle && npm run check -w @jamie-burkart/www && npm run check:compiled-lifecycle-leaks && npm run knowledge-bank && npm run public-safety && npm run check:routes",
    "generate:citations": "node scripts/generate-public-citations.mjs",
    "generate:projection-map": "node scripts/generate-projection-map.mjs",
    "generate:campaign-press": "node scripts/generate-campaign-press-corpus.mjs",
    "check:campaign-press": "node scripts/generate-campaign-press-corpus.mjs --check",
    "check:citations": "node scripts/check-citations.mjs && npm run check:campaign-press",
    "test:citations": "node --test scripts/tests/citations.test.mjs",
    "test:evals": "node --test scripts/tests/eval-runner.test.mjs",
    "report:citations": "node scripts/report-citations.mjs",
    "knowledge-bank": "node scripts/check-knowledge-bank.mjs",
    "public-safety": "node scripts/check-public-safety.mjs",
    "routes": "npm run check:routes",
    "check:routes": "node scripts/check-routes.mjs",
    "check:production": "npm run preflight:production",
    "eval:portfolio": "node scripts/eval-portfolio-readiness.mjs",
    "eval:chad-lens": "node scripts/eval-portfolio-readiness.mjs --rubric evals/chad-lens/rubric.json",
    "eval:knowledge-lifecycle": "node scripts/eval-portfolio-readiness.mjs --rubric evals/knowledge-lifecycle/rubric.json",
    "check:chad-lens": "node scripts/check-chad-lens-contract.mjs",
    "check:knowledge-lifecycle": "node scripts/check-knowledge-lifecycle.mjs && npm run test:knowledge-lifecycle",
    "test:knowledge-lifecycle": "node --test scripts/tests/knowledge-lifecycle.test.mjs",
    "knowledge:intake": "node scripts/intake-knowledge-lead.mjs",
    "report:knowledge-lifecycle": "node scripts/report-knowledge-lifecycle.mjs",
    "query:knowledge-lifecycle": "node scripts/query-knowledge-lifecycle.mjs",
    "check:compiled-lifecycle-leaks": "node scripts/check-compiled-lifecycle-leaks.mjs",
    "preflight:staging": "APP_ENV=staging SITE_ENV=staging NEXT_PUBLIC_DEPLOY_ENV=staging SITE_URL=https://staging.jamieburk.art NEXT_PUBLIC_SITE_URL=https://staging.jamieburk.art NEXT_PUBLIC_ROBOTS_POLICY=noindex npm run check",
    "preflight:production": "APP_ENV=production SITE_ENV=production NEXT_PUBLIC_DEPLOY_ENV=production SITE_URL=https://jamieburk.art NEXT_PUBLIC_SITE_URL=https://jamieburk.art NEXT_PUBLIC_ROBOTS_POLICY=index npm run check"
  }
}
