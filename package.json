{
  "name": "jamie-burkart-monorepo",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=26 <27",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --filter @jamie-burkart/www dev",
    "build": "pnpm --filter @jamie-burkart/www build",
    "start": "pnpm --filter @jamie-burkart/www start",
    "lint": "pnpm --filter @jamie-burkart/www lint",
    "typecheck": "pnpm --filter @jamie-burkart/www typecheck",
    "check": "pnpm typecheck && pnpm lint && pnpm build"
  }
}
