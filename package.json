{
  "name": "jamie-burkart-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=26 <27",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "npm run dev -w @jamie-burkart/www",
    "build": "npm run build -w @jamie-burkart/www",
    "start": "npm run start -w @jamie-burkart/www",
    "lint": "npm run lint -w @jamie-burkart/www",
    "typecheck": "npm run typecheck -w @jamie-burkart/www",
    "check:public-safety": "node scripts/check-public-safety.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "check:production": "node scripts/preflight-production.mjs",
    "preflight:production": "npm run check:production",
    "prelaunch:production": "npm run check:production",
    "check": "npm run typecheck && npm run lint && npm run check:public-safety && npm run check:routes && npm run build"
  }
}
