{
  "name": "jamie-burkart-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=26 <27",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "npm run dev -w @jamie-burkart/www",
    "build": "npm run build -w @jamie-burkart/www",
    "start": "npm run start -w @jamie-burkart/www",
    "lint": "npm run lint -w @jamie-burkart/www",
    "typecheck": "npm run typecheck -w @jamie-burkart/www",
    "check": "npm run check:citations && npm run test:citations && npm run check:evals && npm run test:evals && npm run check:knowledge-lifecycle && npm run test:knowledge-lifecycle && npm run atlas:verify-legacy && npm run atlas:verify-deprecation && npm run atlas:verify-history && npm run atlas:check && npm run atlas:test && npm run check -w @jamie-burkart/www && npm run knowledge-bank && npm run public-safety && npm run check:routes",
    "generate:citations": "node scripts/generate-public-citations.mjs",
    "check:citations": "node scripts/check-citations.mjs",
    "test:citations": "node --test scripts/tests/citations.test.mjs",
    "report:citations": "node scripts/report-citations.mjs",
    "check:evals": "node scripts/evals/check-launch-readiness.mjs --contract-only",
    "test:evals": "node --test scripts/tests/launch-readiness-evals.test.mjs",
    "eval:launch": "node scripts/evals/check-launch-readiness.mjs",
    "eval:launch:gate": "node scripts/evals/check-launch-readiness.mjs --gate",
    "eval:launch:browser": "node scripts/evals/browser-launch-readiness.mjs",
    "eval:launch:release": "node scripts/evals/check-launch-readiness.mjs --browser-report ${LAUNCH_BROWSER_REPORT:-reports/generated/launch-browser.production.json} --assessment evals/launch-readiness/assessment.latest.json --release",
    "eval:launch:compare": "node scripts/evals/compare-launch-readiness.mjs",
    "check:knowledge-lifecycle": "node scripts/evals/check-knowledge-lifecycle.mjs --contract-only",
    "test:knowledge-lifecycle": "node --test scripts/tests/knowledge-lifecycle-evals.test.mjs",
    "eval:knowledge-lifecycle": "node scripts/evals/check-knowledge-lifecycle.mjs",
    "eval:knowledge-lifecycle:gate": "node scripts/evals/check-knowledge-lifecycle.mjs --assessment evals/knowledge-lifecycle/assessment.latest.json --gate",
    "atlas:generate": "node packages/atlas/bin/atlas.mjs generate",
    "atlas:migrate-legacy": "node packages/atlas/bin/atlas.mjs migrate-legacy",
    "atlas:verify-legacy": "node packages/atlas/bin/atlas.mjs verify-legacy",
    "atlas:verify-deprecation": "node packages/atlas/bin/atlas.mjs verify-deprecation",
    "atlas:verify-history": "node packages/atlas/bin/atlas.mjs verify-history",
    "atlas:refresh-sources": "node packages/atlas/bin/atlas.mjs refresh-sources",
    "atlas:verify-sources": "node packages/atlas/bin/atlas.mjs verify-sources",
    "atlas:check": "node packages/atlas/bin/atlas.mjs check",
    "atlas:test": "node --test packages/atlas/test/*.test.mjs",
    "atlas:eval": "node packages/atlas/bin/atlas.mjs eval",
    "atlas:query": "node packages/atlas/bin/atlas.mjs query",
    "atlas:knowledge": "node packages/atlas/bin/atlas.mjs knowledge",
    "atlas:records": "node packages/atlas/bin/atlas.mjs records",
    "atlas:artifact": "node packages/atlas/bin/atlas.mjs artifact",
    "atlas:source-object": "node packages/atlas/bin/atlas.mjs source-object",
    "atlas:bundle": "node packages/atlas/bin/atlas.mjs bundle",
    "atlas:verify-bundle": "node packages/atlas/bin/atlas.mjs verify-bundle",
    "atlas:release": "node packages/atlas/bin/atlas.mjs release",
    "atlas:explain": "node packages/atlas/bin/atlas.mjs explain",
    "knowledge-bank": "node scripts/check-knowledge-bank.mjs",
    "public-safety": "node scripts/check-public-safety.mjs",
    "routes": "npm run check:routes",
    "check:routes": "node scripts/check-routes.mjs",
    "check:production": "npm run preflight:production",
    "preflight:staging": "APP_ENV=staging SITE_ENV=staging NEXT_PUBLIC_DEPLOY_ENV=staging SITE_URL=https://staging.jamieburk.art NEXT_PUBLIC_SITE_URL=https://staging.jamieburk.art NEXT_PUBLIC_ROBOTS_POLICY=noindex npm run check",
    "preflight:production": "APP_ENV=production SITE_ENV=production NEXT_PUBLIC_DEPLOY_ENV=production SITE_URL=https://jamieburk.art NEXT_PUBLIC_SITE_URL=https://jamieburk.art NEXT_PUBLIC_ROBOTS_POLICY=index npm run check && npm run eval:launch:release"
  },
  "devDependencies": {
    "playwright": "^1.55.1"
  }
}
