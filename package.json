{
  "name": "jamie-burkart-portfolio",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=26 <27",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --filter @jamie-burkart/web dev",
    "build": "pnpm --filter @jamie-burkart/web build",
    "start": "pnpm --filter @jamie-burkart/web start",
    "lint": "pnpm --filter @jamie-burkart/web lint",
    "typecheck": "pnpm --filter @jamie-burkart/web typecheck",
    "check": "pnpm typecheck && pnpm lint && pnpm build",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "3.7.4"
  }
}
