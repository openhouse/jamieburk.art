{
  "name": "jamie-burkart-site",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "npm run dev -w @jamie/web",
    "build": "npm run build -w @jamie/web",
    "start": "npm run start -w @jamie/web",
    "lint": "npm run lint -w @jamie/web",
    "typecheck": "npm run typecheck -w @jamie/web",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm run build"
  },
  "devDependencies": {
    "prettier": "latest"
  }
}
