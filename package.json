{
  "name": "jamieburk-art",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=26 <27",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "npm run dev -w @jamieburkart/site",
    "build": "npm run build -w @jamieburkart/site",
    "start": "npm run start -w @jamieburkart/site",
    "lint": "npm run lint -w @jamieburkart/site",
    "typecheck": "npm run typecheck -w @jamieburkart/site",
    "test": "npm run test -w @jamieburkart/site",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint"
  }
}
