{
  "name": "jamie-burkart-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=26 <27",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "npm run dev -w @jamie-burkart/www",
    "build": "npm run build -w @jamie-burkart/www",
    "build:webpack": "npm run build:webpack -w @jamie-burkart/www",
    "start": "npm run start -w @jamie-burkart/www",
    "lint": "npm run lint -w @jamie-burkart/www",
    "typecheck": "npm run typecheck -w @jamie-burkart/www",
    "public-safety": "node scripts/check-public-safety.mjs",
    "preflight": "npm run typecheck && npm run lint && npm run build:webpack && npm run public-safety",
    "check:production": "node scripts/check-production-config.mjs && npm run public-safety",
    "check": "npm run check -w @jamie-burkart/www && npm run public-safety"
  }
}
