{
  "name": "jamieburk-art-monorepo",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "pnpm --filter @jamieburk/site dev",
    "build": "pnpm --filter @jamieburk/site build",
    "start": "pnpm --filter @jamieburk/site start",
    "lint": "pnpm --filter @jamieburk/site lint",
    "typecheck": "pnpm --filter @jamieburk/site typecheck",
    "test": "pnpm --filter @jamieburk/site test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm public-safety && pnpm build",
    "public-safety": "pnpm --filter @jamieburk/site public-safety"
  }
}
