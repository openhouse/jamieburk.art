{
  "name": "jamie-burkart-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=26 <27",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "npm run dev -w @jamie-burkart/www",
    "build": "npm run build -w @jamie-burkart/www",
    "start": "npm run start -w @jamie-burkart/www",
    "lint": "npm run lint -w @jamie-burkart/www",
    "typecheck": "npm run typecheck -w @jamie-burkart/www",
    "check": "npm run check:launch-evals && npm run check:knowledge-operations && npm run check:knowledge-intake && npm run check:urbanhermit-corpus && npm run evals:urbanhermit-x && npm run check:nycac-facebook-events && npm run evals:nycac-facebook-events && npm run check:facebook-events-archive && npm run evals:facebook-events-archive && npm run check:wowlist-facebook-posts && npm run evals:wowlist-facebook-posts && npm run check:nycac-facebook-posts && npm run evals:nycac-facebook-posts && npm run check:personal-facebook-posts && npm run evals:personal-facebook-posts && npm run check:citations && npm run test:citations && npm run check -w @jamie-burkart/www && npm run knowledge-bank && npm run public-safety && npm run check:routes",
    "check:launch-evals": "node scripts/check-launch-readiness-evals.mjs && node --test scripts/tests/launch-readiness-evals.test.mjs",
    "check:knowledge-operations": "node scripts/report-knowledge-bank.mjs --check && node scripts/report-knowledge-projections.mjs --check && node --test scripts/tests/knowledge-operations.test.mjs",
    "check:knowledge-intake": "node scripts/check-knowledge-intake.mjs",
    "eval:launch-readiness": "node scripts/run-launch-readiness-evals.mjs --report",
    "eval:launch-readiness:v23": "node scripts/run-launch-readiness-evals.mjs --version 23 --report",
    "eval:launch-readiness:strict": "node scripts/run-launch-readiness-evals.mjs --strict",
    "knowledge:query": "node scripts/query-knowledge-bank.mjs",
    "knowledge:report": "node scripts/report-knowledge-bank.mjs",
    "knowledge:projection-map": "node scripts/report-knowledge-projections.mjs",
    "check:urbanhermit-corpus": "node scripts/check-urbanhermit-x-public-ledger.mjs",
    "build:urbanhermit-public-ledger": "node scripts/build-urbanhermit-x-public-ledger.mjs",
    "evals:urbanhermit-x": "node scripts/evals-urbanhermit-x-corpus.mjs",
    "check:nycac-facebook-events": "node scripts/check-nycac-facebook-events-corpus.mjs",
    "evals:nycac-facebook-events": "node scripts/evals-nycac-facebook-events.mjs",
    "check:facebook-events-archive": "node scripts/check-facebook-events-archive.mjs",
    "evals:facebook-events-archive": "node scripts/evals-facebook-events-archive.mjs",
    "check:wowlist-facebook-posts": "node scripts/check-wowlist-facebook-posts.mjs",
    "evals:wowlist-facebook-posts": "node scripts/evals-wowlist-facebook-posts.mjs",
    "check:nycac-facebook-posts": "node scripts/check-nycac-facebook-posts.mjs",
    "evals:nycac-facebook-posts": "node scripts/evals-nycac-facebook-posts.mjs",
    "check:personal-facebook-posts": "node scripts/check-personal-facebook-posts.mjs && node --test scripts/tests/personal-facebook-posts-validation.test.mjs",
    "evals:personal-facebook-posts": "node scripts/evals-personal-facebook-posts.mjs",
    "generate:citations": "node scripts/generate-public-citations.mjs",
    "check:citations": "node scripts/check-citations.mjs",
    "test:citations": "node --test scripts/tests/citations.test.mjs",
    "report:citations": "node scripts/report-citations.mjs",
    "knowledge-bank": "node scripts/check-knowledge-bank.mjs",
    "public-safety": "node scripts/check-public-safety.mjs",
    "routes": "npm run check:routes",
    "check:routes": "node scripts/check-routes.mjs",
    "check:production": "npm run preflight:production",
    "preflight:staging": "APP_ENV=staging SITE_ENV=staging NEXT_PUBLIC_DEPLOY_ENV=staging SITE_URL=https://staging.jamieburk.art NEXT_PUBLIC_SITE_URL=https://staging.jamieburk.art NEXT_PUBLIC_ROBOTS_POLICY=noindex npm run check",
    "preflight:production": "APP_ENV=production SITE_ENV=production NEXT_PUBLIC_DEPLOY_ENV=production SITE_URL=https://jamieburk.art NEXT_PUBLIC_SITE_URL=https://jamieburk.art NEXT_PUBLIC_ROBOTS_POLICY=index npm run check"
  }
}
