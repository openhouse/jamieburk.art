{
  "name": "jamie-burkart-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=26 <27",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "npm run dev -w @jamie-burkart/www",
    "build": "npm run build -w @jamie-burkart/www",
    "start": "npm run start -w @jamie-burkart/www",
    "lint": "npm run lint -w @jamie-burkart/www",
    "typecheck": "npm run typecheck -w @jamie-burkart/www",
    "check": "npm run check:citations && npm run test:citations && npm run wiki:check && npm run wiki:test && npm run wiki:eval && npm run hiring:check && npm run hiring:test && npm run check -w @jamie-burkart/www && npm run knowledge-bank && npm run check:evals",
    "generate:citations": "node scripts/generate-public-citations.mjs",
    "check:citations": "node scripts/check-citations.mjs",
    "test:citations": "node --test scripts/tests/citations.test.mjs",
    "report:citations": "node scripts/report-citations.mjs",
    "knowledge-bank": "node scripts/check-knowledge-bank.mjs",
    "wiki:check": "node scripts/knowledge-wiki/check.mjs",
    "wiki:test": "node --test scripts/knowledge-wiki/wiki.test.mjs",
    "wiki:eval": "node scripts/knowledge-wiki/eval.mjs",
    "wiki:graph": "node scripts/knowledge-wiki/graph.mjs",
    "wiki:report": "node scripts/knowledge-wiki/report.mjs",
    "wiki:tasks": "node scripts/knowledge-wiki/tasks.mjs",
    "wiki:query": "node scripts/knowledge-wiki/query.mjs",
    "hiring:check": "node scripts/hiring-acceptance/check.mjs",
    "hiring:test": "node --test scripts/tests/hiring-acceptance.test.mjs",
    "hiring:report": "node scripts/hiring-acceptance/report.mjs",
    "hiring:discover": "node scripts/hiring-acceptance/discover.mjs",
    "public-safety": "node scripts/check-public-safety.mjs",
    "check:knowledge-lifecycle": "node scripts/check-knowledge-lifecycle.mjs",
    "check:chad-lens": "node scripts/check-chad-lens.mjs",
    "check:portfolio-readiness": "node scripts/check-portfolio-readiness.mjs",
    "check:professor-lenses": "node scripts/check-professor-lenses.mjs",
    "check:blind-spots": "node scripts/check-blind-spots.mjs",
    "check:nycac-shared-folder": "node scripts/check-nycac-shared-folder.mjs",
    "check:eval-integrity": "node scripts/check-eval-integrity.mjs",
    "test:evals": "node --test scripts/tests/knowledge-lifecycle.test.mjs scripts/tests/blind-spots.test.mjs scripts/tests/eval-integrity.test.mjs scripts/tests/nycac-shared-folder.test.mjs",
    "check:evals": "npm run check:knowledge-lifecycle && npm run check:chad-lens && npm run check:portfolio-readiness && npm run check:professor-lenses && npm run check:blind-spots && npm run check:nycac-shared-folder && npm run test:evals && npm run check:eval-integrity && npm run public-safety && npm run check:routes",
    "knowledge:intake": "node scripts/intake-knowledge-lead.mjs",
    "knowledge:query": "node scripts/query-knowledge-bank.mjs",
    "report:knowledge-lifecycle": "node scripts/report-knowledge-lifecycle.mjs",
    "routes": "npm run check:routes",
    "check:routes": "node scripts/check-routes.mjs",
    "check:production": "npm run preflight:production",
    "preflight:staging": "APP_ENV=staging SITE_ENV=staging NEXT_PUBLIC_DEPLOY_ENV=staging SITE_URL=https://staging.jamieburk.art NEXT_PUBLIC_SITE_URL=https://staging.jamieburk.art NEXT_PUBLIC_ROBOTS_POLICY=noindex npm run check",
    "preflight:production": "APP_ENV=production SITE_ENV=production NEXT_PUBLIC_DEPLOY_ENV=production SITE_URL=https://jamieburk.art NEXT_PUBLIC_SITE_URL=https://jamieburk.art NEXT_PUBLIC_ROBOTS_POLICY=index npm run check"
  }
}
