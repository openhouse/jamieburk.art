{
  "name": "jamie-burkart-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=26 <27",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "npm run dev -w @jamie-burkart/www",
    "build": "npm run build -w @jamie-burkart/www",
    "start": "npm run start -w @jamie-burkart/www",
    "lint": "npm run lint -w @jamie-burkart/www",
    "typecheck": "npm run typecheck -w @jamie-burkart/www",
    "check": "npm run check:citations && npm run test:citations && npm run evals:portfolio && npm run evals:professor-lenses && npm run test:professor-lenses && npm run test:accessibility-contrast && npm run test:accessibility-evidence && npm run evals:layout && npm run test:layout && npm run evals:composite && npm run test:composite && npm run test:lifecycle-operations && npm run check:knowledge-evals && npm run test:knowledge-evals && npm run evals:participation-continuity && npm run test:participation-continuity && npm run evals:icloud-teams-archive && npm run test:icloud-teams-archive-guard && npm run evals:nycac-shared-folder && npm run test:nycac-shared-folder && npm run test:personal-facebook-posts-guard && npm run evals:kcspacesfund-facebook-posts && npm run evals:jamie-personal-facebook-posts && npm run check:rfcs && npm run photos:check && npm run photos:test && npm run photos:eval && npm run wiki:check && npm run wiki:employment:check && npm run wiki:test && npm run wiki:eval && npm run check -w @jamie-burkart/www && npm run knowledge-bank && npm run public-safety && npm run check:routes",
    "generate:citations": "node scripts/generate-public-citations.mjs",
    "check:citations": "node scripts/check-citations.mjs",
    "test:citations": "node --test scripts/tests/citations.test.mjs",
    "report:citations": "node scripts/report-citations.mjs",
    "check:rfcs": "node scripts/check-rfcs.mjs",
    "photos:check": "node scripts/photography/photo-knowledge.mjs check",
    "photos:report": "node scripts/photography/photo-knowledge.mjs report",
    "photos:placements": "node scripts/photography/photo-knowledge.mjs placements",
    "photos:permissions": "node scripts/photography/photo-knowledge.mjs permissions",
    "photos:curatorial:check": "node scripts/photography/photo-knowledge.mjs curatorial-check",
    "photos:curatorial:run": "node scripts/photography/photo-knowledge.mjs curatorial-run",
    "photos:manifest": "node scripts/photography/photo-knowledge.mjs manifest",
    "photos:usage": "node scripts/photography/photo-knowledge.mjs usage",
    "photos:impact": "node scripts/photography/photo-knowledge.mjs impact",
    "photos:health": "node scripts/photography/photo-knowledge.mjs health",
    "photos:edition": "node scripts/photography/photo-knowledge.mjs edition",
    "photos:recollection": "node scripts/photography/photo-knowledge.mjs recollection",
    "photos:rollback": "node scripts/photography/photo-knowledge.mjs rollback",
    "photos:test": "node --test scripts/photography/photo-knowledge.test.mjs",
    "photos:eval": "node scripts/photography/photo-knowledge.mjs eval",
    "photos:hillclimb": "npm run photos:check && npm run photos:test && npm run photos:eval",
    "evals:portfolio": "node scripts/check-portfolio-evals.mjs",
    "evals:composite": "node scripts/check-composite-integration.mjs",
    "test:composite": "node --test scripts/tests/composite-integration.test.mjs",
    "test:lifecycle-operations": "node --test scripts/tests/lifecycle-operations.test.mjs",
    "evals:professor-lenses": "node scripts/evals-professor-lenses.mjs",
    "evals:professor-lenses:receipt": "node scripts/write-professor-candidate-receipt.mjs",
    "evals:professor-lenses:browser": "node scripts/generate-professor-browser-evidence.mjs",
    "test:professor-lenses": "node --test scripts/tests/professor-lens-eval.test.mjs",
    "test:accessibility-contrast": "node --test scripts/tests/accessibility-contrast.test.mjs",
    "test:accessibility-evidence": "node --test scripts/knowledge-wiki/accessibility-evidence.test.mjs",
    "evals:accessibility:refresh": "node scripts/knowledge-wiki/generate-accessibility-evidence.mjs",
    "evals:layout": "node scripts/check-layout-photography.mjs",
    "test:layout": "node --test scripts/tests/layout-photography.test.mjs",
    "check:knowledge-evals": "node scripts/check-knowledge-evals.mjs",
    "test:knowledge-evals": "node --test scripts/tests/knowledge-evals.test.mjs",
    "test:personal-facebook-posts-guard": "node --test scripts/tests/personal-facebook-posts-guard.test.mjs",
    "report:knowledge-evals": "node scripts/report-knowledge-evals.mjs",
    "evals:kcspacesfund-facebook-posts": "node scripts/evals-kcspacesfund-facebook-posts.mjs",
    "evals:jamie-personal-facebook-posts": "node scripts/evals-jamie-personal-facebook-posts.mjs",
    "evals:participation-continuity": "node scripts/evals-participation-continuity.mjs",
    "test:participation-continuity": "node --test scripts/tests/participation-continuity.test.mjs",
    "evals:icloud-teams-archive": "node scripts/evals-icloud-teams-archive.mjs",
    "test:icloud-teams-archive-guard": "node --test scripts/tests/icloud-teams-archive-guard.test.mjs",
    "evals:nycac-shared-folder": "node scripts/evals-nycac-shared-folder.mjs",
    "test:nycac-shared-folder": "node --test scripts/tests/nycac-shared-folder.test.mjs",
    "wiki:check": "node scripts/knowledge-wiki/check-wiki-health.mjs",
    "wiki:test": "node --test scripts/knowledge-wiki/*.test.mjs",
    "wiki:report": "node scripts/knowledge-wiki/report-wiki-health.mjs",
    "wiki:graph": "node scripts/knowledge-wiki/build-wiki-graph.mjs",
    "wiki:tasks": "node scripts/knowledge-wiki/wiki-tasks.mjs",
    "wiki:query": "node scripts/knowledge-wiki/wiki-query.mjs",
    "wiki:eval": "node scripts/knowledge-wiki/evaluate-wiki.mjs",
    "wiki:family-closure": "node scripts/knowledge-wiki/family-closure-eval.mjs",
    "wiki:hiring:public": "node scripts/knowledge-wiki/evaluate-hiring-acceptance.mjs",
    "wiki:hiring:gaps": "node scripts/knowledge-wiki/resolve-hiring-gaps.mjs",
    "wiki:employment:report": "node scripts/knowledge-wiki/report-employment-context.mjs",
    "wiki:employment:check": "node scripts/knowledge-wiki/report-employment-context.mjs --check",
    "wiki:hillclimb": "npm run wiki:family-closure && npm run wiki:graph && npm run wiki:report && npm run wiki:employment:report && npm run wiki:check && npm run wiki:employment:check && npm run wiki:test && npm run wiki:eval",
    "knowledge-bank": "node scripts/check-knowledge-bank.mjs",
    "public-safety": "node scripts/check-public-safety.mjs",
    "routes": "npm run check:routes",
    "check:routes": "node scripts/check-routes.mjs",
    "check:production": "npm run preflight:production",
    "preflight:staging": "APP_ENV=staging SITE_ENV=staging NEXT_PUBLIC_DEPLOY_ENV=staging SITE_URL=https://staging.jamieburk.art NEXT_PUBLIC_SITE_URL=https://staging.jamieburk.art NEXT_PUBLIC_ROBOTS_POLICY=noindex npm run check",
    "preflight:production": "APP_ENV=production SITE_ENV=production NEXT_PUBLIC_DEPLOY_ENV=production SITE_URL=https://jamieburk.art NEXT_PUBLIC_SITE_URL=https://jamieburk.art NEXT_PUBLIC_ROBOTS_POLICY=index npm run check"
  },
  "devDependencies": {
    "axe-core": "^4.12.1",
    "gray-matter": "^4.0.3",
    "playwright-core": "^1.61.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "zod": "^4.4.3"
  }
}
