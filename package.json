{
  "name": "jamie-burkart-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=26 <27",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "npm run dev -w @jamie-burkart/www",
    "build": "npm run build -w @jamie-burkart/www",
    "start": "npm run start -w @jamie-burkart/www",
    "lint": "npm run lint -w @jamie-burkart/www",
    "typecheck": "npm run typecheck -w @jamie-burkart/www",
    "check": "npm run check:citations && npm run test:citations && npm run evals:portfolio && npm run test:portfolio-evals && npm run knowledge-lifecycle && npm run test:knowledge-lifecycle && npm run check:nycartc-corpus && npm run evals:nycartc-x && npm run check:urbanhermit-corpus && npm run evals:urbanhermit-x && npm run check:nycac-facebook-events && npm run evals:nycac-facebook-events && npm run check:facebook-events && npm run evals:facebook-events && npm run check:wowlist-facebook-posts && npm run evals:wowlist-facebook-posts && npm run check:nycac-facebook-posts && npm run evals:nycac-facebook-posts && npm run check:kcspacesfund-facebook-posts && npm run evals:kcspacesfund-facebook-posts && npm run check:personal-facebook-posts && npm run test:personal-facebook-posts && npm run evals:personal-facebook-posts && npm run check -w @jamie-burkart/www && npm run knowledge-bank && npm run public-safety && npm run check:routes",
    "generate:citations": "node scripts/generate-public-citations.mjs",
    "check:citations": "node scripts/check-citations.mjs",
    "test:citations": "node --test scripts/tests/citations.test.mjs",
    "report:citations": "node scripts/report-citations.mjs",
    "evals:portfolio": "node scripts/check-portfolio-evals.mjs",
    "test:portfolio-evals": "node --test scripts/tests/portfolio-evals.test.mjs",
    "knowledge-lifecycle": "node scripts/check-knowledge-lifecycle.mjs",
    "test:knowledge-lifecycle": "node --test scripts/tests/knowledge-lifecycle.test.mjs",
    "report:knowledge-lifecycle": "node scripts/report-knowledge-lifecycle.mjs",
    "check:nycartc-corpus": "node scripts/check-nycartc-x-public-ledger.mjs",
    "build:nycartc-public-ledger": "node scripts/build-nycartc-x-public-ledger.mjs",
    "evals:nycartc-x": "node scripts/evals-nycartc-x-corpus.mjs",
    "check:urbanhermit-corpus": "node scripts/check-urbanhermit-x-public-ledger.mjs",
    "build:urbanhermit-public-ledger": "node scripts/build-urbanhermit-x-public-ledger.mjs",
    "evals:urbanhermit-x": "node scripts/evals-urbanhermit-x-corpus.mjs",
    "check:nycac-facebook-events": "node scripts/check-nycac-facebook-events-corpus.mjs",
    "evals:nycac-facebook-events": "node scripts/evals-nycac-facebook-events.mjs",
    "check:facebook-events": "node scripts/check-facebook-personal-wowlist-events.mjs",
    "verify:facebook-events:protected": "node scripts/verify-facebook-personal-wowlist-events-protected-capture.mjs",
    "evals:facebook-events": "node scripts/evals-facebook-personal-wowlist-events.mjs",
    "check:wowlist-facebook-posts": "node scripts/check-wowlist-facebook-posts-corpus.mjs",
    "verify:wowlist-facebook-posts:protected": "node scripts/verify-wowlist-facebook-posts-protected-capture.mjs",
    "evals:wowlist-facebook-posts": "node scripts/evals-wowlist-facebook-posts.mjs",
    "check:nycac-facebook-posts": "node scripts/check-nycac-facebook-posts-corpus.mjs",
    "verify:nycac-facebook-posts:protected": "node scripts/verify-nycac-facebook-posts-protected-capture.mjs",
    "evals:nycac-facebook-posts": "node scripts/evals-nycac-facebook-posts.mjs",
    "check:kcspacesfund-facebook-posts": "node scripts/check-kcspacesfund-facebook-posts-corpus.mjs",
    "verify:kcspacesfund-facebook-posts:protected": "node scripts/verify-kcspacesfund-facebook-posts-protected-capture.mjs",
    "evals:kcspacesfund-facebook-posts": "node scripts/evals-kcspacesfund-facebook-posts.mjs",
    "check:personal-facebook-posts": "node scripts/check-personal-facebook-posts-corpus.mjs",
    "test:personal-facebook-posts": "node --test scripts/tests/personal-facebook-posts-guard.test.mjs",
    "evals:personal-facebook-posts": "node scripts/evals-personal-facebook-posts.mjs",
    "knowledge-bank": "node scripts/check-knowledge-bank.mjs",
    "public-safety": "node scripts/check-public-safety.mjs",
    "routes": "npm run check:routes",
    "check:routes": "node scripts/check-routes.mjs",
    "check:production": "npm run preflight:production",
    "preflight:staging": "APP_ENV=staging SITE_ENV=staging NEXT_PUBLIC_DEPLOY_ENV=staging SITE_URL=https://staging.jamieburk.art NEXT_PUBLIC_SITE_URL=https://staging.jamieburk.art NEXT_PUBLIC_ROBOTS_POLICY=noindex npm run check",
    "preflight:production": "APP_ENV=production SITE_ENV=production NEXT_PUBLIC_DEPLOY_ENV=production SITE_URL=https://jamieburk.art NEXT_PUBLIC_SITE_URL=https://jamieburk.art NEXT_PUBLIC_ROBOTS_POLICY=index npm run check"
  }
}
