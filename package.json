{
  "name": "jamie-burkart-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=26 <27",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "npm run dev -w @jamie-burkart/www",
    "build": "npm run build -w @jamie-burkart/www",
    "start": "npm run start -w @jamie-burkart/www",
    "lint": "npm run lint -w @jamie-burkart/www",
    "typecheck": "npm run typecheck -w @jamie-burkart/www",
    "check": "npm run check:citations && npm run test:citations && npm run test:knowledge-bank && npm run check:knowledge-intake && npm run test:knowledge-intake && npm run test:portfolio-readiness && npm run check -w @jamie-burkart/www && npm run knowledge-bank && npm run evals:portfolio && npm run evals:chad-lens && npm run evals:margaret-morse && npm run evals:warren-sack && npm run evals:knowledge-bank-lifecycle && npm run evals:blind-spots && npm run public-safety && npm run check:routes && npm run evals:portfolio-readiness",
    "generate:citations": "node scripts/generate-public-citations.mjs",
    "check:citations": "node scripts/check-citations.mjs",
    "test:citations": "node --test scripts/tests/citations.test.mjs",
    "test:knowledge-bank": "node --test scripts/tests/wowlist-facebook-guard.test.mjs scripts/tests/nycartc-facebook-guard.test.mjs scripts/tests/kcspacesfund-facebook-guard.test.mjs scripts/tests/personal-facebook-posts-guard.test.mjs",
    "check:knowledge-intake": "node scripts/check-knowledge-intake.mjs",
    "test:knowledge-intake": "node --test scripts/tests/knowledge-intake.test.mjs",
    "knowledge:intake": "node scripts/intake-knowledge-lead.mjs",
    "knowledge:query": "node scripts/query-knowledge-bank.mjs",
    "knowledge:palette": "node scripts/query-knowledge-bank.mjs --publication-safe",
    "test:portfolio-readiness": "node --test scripts/tests/portfolio-readiness.test.mjs",
    "report:citations": "node scripts/report-citations.mjs",
    "knowledge-bank": "node scripts/check-knowledge-bank.mjs",
    "check:knowledge-bank": "npm run knowledge-bank",
    "evals:portfolio": "node scripts/check-portfolio-evals.mjs",
    "evals:chad-lens": "node scripts/check-chad-lens-eval.mjs",
    "evals:margaret-morse": "node scripts/check-practice-lens-eval.mjs margaret-morse-lens",
    "evals:warren-sack": "node scripts/check-practice-lens-eval.mjs warren-sack-lens",
    "evals:knowledge-bank-lifecycle": "node scripts/check-knowledge-bank-lifecycle-evals.mjs",
    "evals:blind-spots": "node scripts/check-portfolio-system-blind-spots.mjs",
    "evals:portfolio-readiness": "node scripts/check-portfolio-readiness.mjs",
    "evals:portfolio-readiness:application": "node scripts/check-portfolio-readiness.mjs --profile application-ready",
    "evals:portfolio-readiness:production": "node scripts/check-portfolio-readiness.mjs --profile production-ready",
    "evals:portfolio-readiness:capture": "node scripts/capture-portfolio-readiness.mjs",
    "public-safety": "node scripts/check-public-safety.mjs",
    "routes": "npm run check:routes",
    "check:routes": "node scripts/check-routes.mjs",
    "check:production": "npm run preflight:production",
    "preflight:staging": "APP_ENV=staging SITE_ENV=staging NEXT_PUBLIC_DEPLOY_ENV=staging SITE_URL=https://staging.jamieburk.art NEXT_PUBLIC_SITE_URL=https://staging.jamieburk.art NEXT_PUBLIC_ROBOTS_POLICY=noindex npm run check",
    "preflight:production": "APP_ENV=production SITE_ENV=production NEXT_PUBLIC_DEPLOY_ENV=production SITE_URL=https://jamieburk.art NEXT_PUBLIC_SITE_URL=https://jamieburk.art NEXT_PUBLIC_ROBOTS_POLICY=index sh -c 'npm run check && npm run evals:portfolio-readiness:production'"
  }
}
