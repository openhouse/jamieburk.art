{
  "name": "jamie-burkart-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=26 <27",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "npm run dev -w @jamie-burkart/www",
    "build": "npm run build -w @jamie-burkart/www",
    "start": "npm run start -w @jamie-burkart/www",
    "lint": "npm run lint -w @jamie-burkart/www",
    "typecheck": "npm run typecheck -w @jamie-burkart/www",
    "check": "npm run typecheck && npm run lint && npm run public-safety && npm run knowledge-bank && npm run check:routes && npm run build",
    "knowledge-bank": "node scripts/check-knowledge-bank.mjs",
    "public-safety": "node scripts/check-public-safety.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "check:production": "node scripts/preflight-production.mjs --index",
    "preflight:staging": "node scripts/preflight-staging.mjs",
    "preflight:production:soft": "node scripts/preflight-production.mjs --soft",
    "preflight:production": "node scripts/preflight-production.mjs --index"
  }
}
