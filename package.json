{
  "name": "jamie-burkart-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=26 <27",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "npm run dev -w @jamie-burkart/www",
    "build": "npm run build -w @jamie-burkart/www",
    "start": "npm run start -w @jamie-burkart/www",
    "lint": "npm run lint -w @jamie-burkart/www",
    "typecheck": "npm run typecheck -w @jamie-burkart/www",
    "check": "npm run evals:fast && npm run check:callnyc-corpus && npm run check:wowlist-corpus && npm run check:wowlist-facebook-posts-corpus && npm run eval:wowlist-facebook-posts && npm run check:kctownhall-corpus && npm run check:nycartc-corpus && npm run check:urbanhermit-corpus && npm run eval:urbanhermit-corpus && npm run check:nycac-facebook-events-corpus && npm run eval:nycac-facebook-events && npm run check:nycac-facebook-posts-corpus && npm run eval:nycac-facebook-posts && npm run check:kcspaces-facebook-posts-corpus && npm run eval:kcspaces-facebook-posts && npm run check:jamie-facebook-posts && npm run eval:jamie-facebook-posts && npm run check:personal-wowlist-facebook-events-corpus && npm run eval:personal-wowlist-facebook-events && npm run eval:teams-archive-followup && npm run eval:wowlist-sunday-dinner-callscript-lineage && npm run eval:nycac-government-value && npm run eval:blind-spots && npm run test:blind-spots && npm run check:citations && npm run test:citations && npm run evals:portfolio && npm run test:portfolio-evals && npm run eval:knowledge-bank && npm run test:knowledge-development && npm run check:chad-lens && npm run check -w @jamie-burkart/www && npm run knowledge-bank && npm run public-safety && npm run check:routes",
    "evals:fast": "node scripts/check-composite-evals.mjs --profile=fast && node --test scripts/tests/composite-evals.test.mjs",
    "evals:knowledge": "npm run eval:knowledge-bank",
    "evals:portfolio:application": "node scripts/check-composite-evals.mjs --profile=application",
    "evals:portfolio:production": "node scripts/check-composite-evals.mjs --profile=release",
    "evals:blind-spots": "npm run eval:blind-spots",
    "evals:browser": "node scripts/check-composite-evals.mjs --profile=browser --receipt=.agents/evals/runs/browser-evidence-2026-07-16.json",
    "evals:release": "node scripts/check-composite-evals.mjs --profile=release",
    "knowledge:intake": "node scripts/intake-knowledge-lead.mjs",
    "knowledge:query": "node scripts/query-knowledge-bank.mjs",
    "knowledge:report": "node scripts/report-knowledge-maintenance.mjs",
    "check:callnyc-corpus": "node scripts/derive-callnyc-x-corpus.mjs > /dev/null",
    "check:wowlist-corpus": "node scripts/derive-wowlist-x-corpus.mjs > /dev/null",
    "check:wowlist-facebook-posts-corpus": "node scripts/check-wowlist-facebook-posts-corpus.mjs",
    "eval:wowlist-facebook-posts": "node scripts/evals-wowlist-facebook-posts.mjs",
    "check:kctownhall-corpus": "node scripts/derive-kctownhall-x-corpus.mjs > /dev/null",
    "check:nycartc-corpus": "node scripts/derive-nycartc-x-corpus.mjs > /dev/null",
    "check:urbanhermit-corpus": "node scripts/check-urbanhermit-x-corpus.mjs > /dev/null",
    "eval:urbanhermit-corpus": "node scripts/evals-urbanhermit-x-corpus.mjs",
    "check:nycac-facebook-events-corpus": "node scripts/check-nycac-facebook-events-corpus.mjs",
    "eval:nycac-facebook-events": "node scripts/evals-nycac-facebook-events.mjs",
    "check:nycac-facebook-posts-corpus": "node scripts/check-nycac-facebook-posts-corpus.mjs",
    "eval:nycac-facebook-posts": "node scripts/evals-nycac-facebook-posts.mjs",
    "check:kcspaces-facebook-posts-corpus": "node scripts/check-kcspaces-facebook-posts-corpus.mjs",
    "eval:kcspaces-facebook-posts": "node scripts/evals-kcspaces-facebook-posts.mjs",
    "check:jamie-facebook-posts": "node scripts/check-jamie-personal-facebook-posts.mjs",
    "eval:jamie-facebook-posts": "node scripts/evals-jamie-personal-facebook-posts.mjs",
    "check:personal-wowlist-facebook-events-corpus": "node scripts/check-personal-wowlist-facebook-events-corpus.mjs",
    "eval:personal-wowlist-facebook-events": "node scripts/evals-personal-wowlist-facebook-events.mjs",
    "eval:teams-archive-followup": "node scripts/evals-teams-archive-followup.mjs",
    "eval:wowlist-sunday-dinner-callscript-lineage": "node scripts/evals-wowlist-sunday-dinner-callscript-lineage.mjs",
    "eval:nycac-government-value": "node scripts/evals-nycac-government-value.mjs",
    "eval:blind-spots": "node scripts/check-portfolio-blind-spots.mjs",
    "test:blind-spots": "node --test scripts/tests/portfolio-blind-spots.test.mjs",
    "report:knowledge-maintenance": "node scripts/report-knowledge-maintenance.mjs",
    "generate:citations": "node scripts/generate-public-citations.mjs",
    "generate:resume-pdf": "node scripts/generate-resume-pdf.mjs",
    "report:knowledge-policy-fingerprints": "node scripts/report-knowledge-policy-fingerprints.mjs",
    "check:citations": "node scripts/check-citations.mjs",
    "test:citations": "node --test scripts/tests/citations.test.mjs",
    "report:citations": "node scripts/report-citations.mjs",
    "evals:portfolio": "node scripts/check-portfolio-evals.mjs",
    "test:portfolio-evals": "node --test scripts/tests/portfolio-evals.test.mjs",
    "eval:knowledge-bank": "node scripts/check-knowledge-development.mjs --consecutive=2 --hybrid-report=.agents/evals/runs/knowledge-bank-development-hybrid-2026-07-16.json",
    "test:knowledge-development": "node --test scripts/tests/knowledge-development.test.mjs",
    "check:chad-lens": "node scripts/check-chad-lens.mjs",
    "knowledge-bank": "node scripts/check-knowledge-bank.mjs",
    "public-safety": "node scripts/check-public-safety.mjs",
    "routes": "npm run check:routes",
    "check:routes": "node scripts/check-routes.mjs",
    "check:production": "npm run preflight:production",
    "preflight:staging": "APP_ENV=staging SITE_ENV=staging NEXT_PUBLIC_DEPLOY_ENV=staging SITE_URL=https://staging.jamieburk.art NEXT_PUBLIC_SITE_URL=https://staging.jamieburk.art NEXT_PUBLIC_ROBOTS_POLICY=noindex npm run check",
    "preflight:production": "APP_ENV=production SITE_ENV=production NEXT_PUBLIC_DEPLOY_ENV=production SITE_URL=https://jamieburk.art NEXT_PUBLIC_SITE_URL=https://jamieburk.art NEXT_PUBLIC_ROBOTS_POLICY=index npm run check"
  }
}
