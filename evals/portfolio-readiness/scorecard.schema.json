{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Composite portfolio readiness scorecard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "evalId",
    "runId",
    "round",
    "evaluatedAt",
    "evaluator",
    "candidate",
    "rubricDigest",
    "criteria",
    "releaseRecommendation",
    "unresolvedHumanChecks"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "evalId": {
      "type": "string",
      "const": "portfolio-readiness-composite-v1"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "evaluatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "kind",
        "provider",
        "model",
        "sessionId",
        "independentFromAuthor"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "enum": [
            "hiring-and-comprehension-judge",
            "evidence-and-systems-judge"
          ]
        },
        "kind": {
          "type": "string",
          "const": "llm-judge"
        },
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "independentFromAuthor": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "digest"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "rubricDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "criteria": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "score",
          "confidence",
          "evidence",
          "hardGatePassed",
          "repair",
          "antiGamingCheck"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "score": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              {
                "type": "null"
              }
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "not-applicable"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "observation"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "observation": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "hardGatePassed": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "repair": {
            "type": "string",
            "minLength": 1
          },
          "antiGamingCheck": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "releaseRecommendation": {
      "type": "string",
      "enum": [
        "iterate",
        "system-ready",
        "application-ready",
        "production-ready"
      ]
    },
    "unresolvedHumanChecks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
