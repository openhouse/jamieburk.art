{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Practice lens independent judge artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "judgeRunId",
    "evalId",
    "role",
    "candidateSha256",
    "allHardGatesPassed",
    "hardGateFindings",
    "dimensionFindings",
    "score",
    "regressions",
    "requiredRevisions",
    "limitations"
  ],
  "properties": {
    "judgeRunId": { "type": "string", "minLength": 1 },
    "evalId": { "type": "string", "minLength": 1 },
    "role": { "type": "string", "minLength": 1 },
    "candidateSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "allHardGatesPassed": { "type": "boolean" },
    "hardGateFindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "passed", "finding"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "passed": { "type": "boolean" },
          "finding": { "type": "string", "minLength": 1 }
        }
      }
    },
    "dimensionFindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "passed", "finding"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "passed": { "type": "boolean" },
          "finding": { "type": "string", "minLength": 1 }
        }
      }
    },
    "score": { "type": "integer", "minimum": 1, "maximum": 5 },
    "regressions": { "type": "array", "items": { "type": "string" } },
    "requiredRevisions": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}
