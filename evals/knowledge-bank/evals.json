  "criteria": [
    {
      "id": "KB-EVAL-INTAKE",
      "label": "Lossless public-safe intake",
      "weight": 0.15,
      "minimumScore": 5,
      "intent": "Every supplied fragment receives a stable ID, project association, disposition, boundary, and next relationship rather than disappearing silently."
    },
    {
      "id": "KB-EVAL-ATOMICITY",
      "label": "Observation atomicity",
      "weight": 0.1,
      "minimumScore": 4,
      "intent": "Sources are decomposed into proposition-level observations with locators, limitations, and explicit links to claims or research questions."
    },
    {
      "id": "KB-EVAL-SCOPE",
      "label": "Evidence scope integrity",
      "weight": 0.15,
      "minimumScore": 5,
      "intent": "Every source records what it establishes and does not establish; evidence relationships never silently broaden a source."
    },
    {
      "id": "KB-EVAL-MATURATION",
      "label": "Claim maturation",
      "weight": 0.15,
      "minimumScore": 4,
      "intent": "Defensible claims carry evidence, boundaries, anti-claims, review data, and open inquiries where material uncertainty remains."
    },
    {
      "id": "KB-EVAL-PROJECTION",
      "label": "Projection discipline",
      "weight": 0.15,
      "minimumScore": 5,
      "intent": "Epistemic readiness remains separate from compositional selection; held claims have no public surface and active claims have an authorized page plan."
    },
    {
      "id": "KB-EVAL-COVERAGE",
      "label": "Existing-site evidence coverage",
      "weight": 0.1,
      "minimumScore": 4,
      "intent": "The framework improves support for consequential claims already represented on the public site, without overloading the composition."
    },
    {
      "id": "KB-EVAL-SAFETY",
      "label": "Public safety and collective credit",
      "weight": 0.1,
      "minimumScore": 5,
      "intent": "No private locator or raw archive leaks; participant detail, policy causation, and collective outcomes remain explicitly bounded."
    },
    {
      "id": "KB-EVAL-RECOMPOSITION",
      "label": "Recomposition and feedback readiness",
      "weight": 0.1,
      "minimumScore": 4,
      "intent": "Unselected claims and open questions remain usable for future applications, site arguments, collaborator proofs, and photo-editor feedback loops."
    },
    {
      "id": "KB-EVAL-PRESS-ARCHIVE",
      "label": "Campaign press archive completeness",
      "weight": 0,
      "minimumScore": 5,
      "intent": "Every press-list appearance across the four campaign sites is preserved with campaign provenance, deduplicated article identity, availability context, scope boundaries, and a maturation disposition."
    },
    {
      "id": "KB-EVAL-KCTH-FUNDING-LIFECYCLE",
      "label": "KC Town Hall funding lifecycle integrity",
      "weight": 0,
      "minimumScore": 5,
      "intent": "The bank and public projection preserve the full official sequence from CCED recommendation through Council acceptance and appropriation to zero disbursement, withdrawal, and return of the unused funds, without converting collective authorization into individual receipt or sole causation."
    },
    {
      "id": "KB-EVAL-TEAMS-ARCHIVE-PRODUCTION",
      "label": "Teams archive production integrity",
      "weight": 0,
      "minimumScore": 5,
      "intent": "Jamie Projects History, CRS, and job-hunt produce bounded sources, atomic observations, held depth, explicit hydration limits, and only one independently supported public projection without exposing private archive material."
    },
    {
      "id": "KB-EVAL-GDRIVE-SHARED-DRIVES-PRODUCTION",
      "label": "Google Drive Shared Drives production integrity",
      "weight": 0,
      "minimumScore": 5,
      "intent": "The 110-drive corpus receives a bounded non-exhaustive map, high-signal close reading, cross-carrier deduplication, protected source handling, collective credit, one strengthened existing projection, and held depth without exposing Shared Drive identifiers or participant records."
    }
  ],
  "hillClimb": {
    "iteration": [
      "Run deterministic checks and a fresh editorial judge against the current bank.",
      "Select the lowest criterion and state one bounded maturation hypothesis.",
      "Improve structure, research, or projection without deleting protected boundaries.",
      "Rerun checks, public-safety validation, and the affected public projection.",
      "Keep only iterations that improve the lowest criterion without regressions."
    ],
    "antiGaming": [
      "Never call a memory a verified claim without a source relationship.",
      "Never improve completeness by placing private paths or raw evidence in the public repo.",
      "Never improve projection coverage by publishing every mature claim.",
      "Never infer sole causation from participation, proximity, or contemporaneous coverage.",
      "Never treat a photograph as self-interpreting proof or consent to publish.",
      "Never turn an appropriation into money received, omit a material later disposition, or erase a documented approval because the project later changed course."
    ],
    "stopWhen": "Every criterion meets its minimum and the weighted target passes in two consecutive fresh-judge runs, with deterministic checks and public safety passing."
  }
}
