{
  "schema_version": 1,
  "id": "three-layer-knowledge-graph-rfc",
  "objective": "Keep semantic meaning, evidence, and source custody distinct while preserving governed transitions and audience-specific projection.",
  "cases": [
    {
      "id": "semantic-radius-stops-before-photo-hub",
      "operation": "semantic-radius",
      "max_degree": 2,
      "seed_ids": ["opportunity"],
      "nodes": [
        { "id": "opportunity", "layer": "semantic" },
        { "id": "capability", "layer": "semantic" },
        { "id": "project", "layer": "semantic" },
        { "id": "photo-index", "layer": "evidence" },
        { "id": "photo-001", "layer": "evidence" },
        { "id": "source-vault", "layer": "custody" }
      ],
      "edges": [
        { "source": "opportunity", "target": "capability", "type": "fits_requirement" },
        { "source": "capability", "target": "project", "type": "demonstrated_by" },
        { "source": "project", "target": "photo-index", "type": "documented_by" },
        { "source": "photo-index", "target": "photo-001", "type": "contains_evidence" },
        { "source": "photo-001", "target": "source-vault", "type": "captured_from" }
      ],
      "expected": {
        "semantic_node_ids": ["capability", "opportunity", "project"],
        "evidence_candidate_ids": ["photo-index"],
        "custody_materialization_ids": []
      }
    },
    {
      "id": "custody-cannot-project-directly",
      "operation": "transition",
      "from": "custody",
      "to": "projection",
      "presented": ["current_authorization", "rights_decision", "editorial_approval"],
      "expected": { "decision": "deny", "reason": "transition-not-defined" }
    },
    {
      "id": "custody-capture-needs-current-authorization",
      "operation": "transition",
      "from": "custody",
      "to": "evidence",
      "presented": ["bounded_request", "source_cutoff", "disposition"],
      "expected": {
        "decision": "deny",
        "rule_id": "bounded-capture",
        "missing": ["current_authorization"]
      }
    },
    {
      "id": "bounded-custody-capture-is-allowed",
      "operation": "transition",
      "from": "custody",
      "to": "evidence",
      "presented": ["bounded_request", "current_authorization", "source_cutoff", "disposition"],
      "expected": { "decision": "allow", "rule_id": "bounded-capture" }
    },
    {
      "id": "evidence-cannot-become-meaning-without-observation",
      "operation": "transition",
      "from": "evidence",
      "to": "semantic",
      "presented": ["evidence_class", "interpretation_review"],
      "expected": {
        "decision": "deny",
        "rule_id": "reviewed-interpretation",
        "missing": ["atomic_observation"]
      }
    },
    {
      "id": "reviewed-evidence-may-inform-semantics",
      "operation": "transition",
      "from": "evidence",
      "to": "semantic",
      "presented": ["atomic_observation", "evidence_class", "interpretation_review"],
      "expected": { "decision": "allow", "rule_id": "reviewed-interpretation" }
    },
    {
      "id": "semantic-maturity-is-not-publication",
      "operation": "transition",
      "from": "semantic",
      "to": "projection",
      "presented": ["recipient", "public_safe_wording", "rights_decision"],
      "expected": {
        "decision": "deny",
        "rule_id": "selective-projection",
        "missing": ["consent_decision", "credit_review", "editorial_approval"]
      }
    },
    {
      "id": "fully-reviewed-semantic-projection-is-eligible",
      "operation": "transition",
      "from": "semantic",
      "to": "projection",
      "presented": ["recipient", "public_safe_wording", "rights_decision", "consent_decision", "credit_review", "editorial_approval"],
      "expected": { "decision": "allow", "rule_id": "selective-projection" }
    },
    {
      "id": "evidence-attachment-needs-semantic-selection",
      "operation": "transition",
      "from": "evidence",
      "to": "projection",
      "presented": ["recipient", "rights_decision", "consent_decision", "credit_review", "editorial_approval"],
      "expected": {
        "decision": "deny",
        "rule_id": "approved-evidence-attachment",
        "missing": ["semantic_selection"]
      }
    },
    {
      "id": "selected-evidence-attachment-is-eligible",
      "operation": "transition",
      "from": "evidence",
      "to": "projection",
      "presented": ["semantic_selection", "recipient", "rights_decision", "consent_decision", "credit_review", "editorial_approval"],
      "expected": { "decision": "allow", "rule_id": "approved-evidence-attachment" }
    },
    {
      "id": "per-seed-and-union-packets-defer-unbudgeted-hub",
      "operation": "packet-plan",
      "seed_ids": ["portfolio", "job-b", "job-a"],
      "evidence_hub": {
        "id": "photo-census",
        "candidate_artifact_count": 180
      },
      "expected": {
        "packet_families": [
          { "id": "per-seed:job-a", "seed_ids": ["job-a"] },
          { "id": "per-seed:job-b", "seed_ids": ["job-b"] },
          { "id": "per-seed:portfolio", "seed_ids": ["portfolio"] },
          { "id": "union", "seed_ids": ["job-a", "job-b", "portfolio"] }
        ],
        "evidence_expansion": {
          "decision": "defer",
          "hub_id": "photo-census",
          "candidate_artifact_count": 180,
          "reason": "explicit-artifact-budget-required"
        },
        "reports_per_seed_coverage": true
      }
    }
  ]
}
