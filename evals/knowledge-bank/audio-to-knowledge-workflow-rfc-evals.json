{
  "schema_version": 1,
  "id": "audio-to-knowledge-workflow-rfc",
  "objective": "Keep audio preservation, bounded context, exact provider return, diarization review, transcript repair, close reading, graph projection, and human authority distinct in one resumable workflow.",
  "review_status": "provisional-pending-Jamie-review",
  "independent_human_holdout": false,
  "cases": [
    { "id": "exact-candidate", "expected": "PASS", "critique": "All ten ordered stages and authority boundaries remain present.", "mutations": [] },
    { "id": "safe-explicit-uncertainty", "expected": "PASS", "critique": "Restating an existing uncertainty requirement is a safe no-op.", "mutations": [{ "target": "candidate", "type": "set", "path": "repair.uncertainty_markers_required", "value": true }] },
    { "id": "reject-stage-reorder", "expected": "FAIL", "critique": "Provider preparation cannot replace exact source custody.", "mutations": [{ "target": "candidate", "type": "set", "path": "stages.1", "value": "provider-input-preparation" }] },
    { "id": "reject-skippable-stage-contract", "expected": "FAIL", "critique": "A mandatory transition cannot be optional.", "mutations": [{ "target": "candidate", "type": "set", "path": "stage_contract.non_skippable", "value": false }] },
    { "id": "reject-missing-receipt", "expected": "FAIL", "critique": "Resume requires a durable stage receipt.", "mutations": [{ "target": "candidate", "type": "set", "path": "stage_contract.receipt_required", "value": false }] },
    { "id": "reject-stale-downstream", "expected": "FAIL", "critique": "Changed source or judgment inputs must invalidate downstream artifacts.", "mutations": [{ "target": "candidate", "type": "set", "path": "stage_contract.downstream_invalidation_on_input_change", "value": false }] },
    { "id": "reject-artifact-collapse", "expected": "FAIL", "critique": "Machine output and repair must remain different artifact layers.", "mutations": [{ "target": "candidate", "type": "set", "path": "artifact_layers.3", "value": "corrected-transcript" }] },
    { "id": "reject-transform-before-preserve", "expected": "FAIL", "critique": "Transformation before exact custody breaks provenance.", "mutations": [{ "target": "candidate", "type": "set", "path": "custody.preservation_before_transformation", "value": false }] },
    { "id": "reject-source-without-checksum", "expected": "FAIL", "critique": "The source needs an exact checksum before derivatives can be trusted.", "mutations": [{ "target": "candidate", "type": "set", "path": "custody.exact_source_checksum_required", "value": false }] },
    { "id": "reject-source-deletion", "expected": "FAIL", "critique": "A transcript does not authorize source deletion.", "mutations": [{ "target": "candidate", "type": "set", "path": "custody.source_deletion_authorized", "value": true }] },
    { "id": "reject-provider-return-loss", "expected": "FAIL", "critique": "Exact machine output must remain available beside repairs.", "mutations": [{ "target": "candidate", "type": "set", "path": "custody.exact_provider_return_preserved", "value": false }] },
    { "id": "reject-unobserved-provider-completion", "expected": "FAIL", "critique": "Submission or pending state is not an observed completed return.", "mutations": [{ "target": "candidate", "type": "set", "path": "custody.provider_completion_requires_observed_return", "value": false }] },
    { "id": "reject-mutable-inputs", "expected": "FAIL", "critique": "A resumable lineage cannot depend on silently mutable inputs.", "mutations": [{ "target": "candidate", "type": "set", "path": "state_machine.immutable_inputs", "value": false }] },
    { "id": "reject-silent-overwrite", "expected": "FAIL", "critique": "Retries must append attempts rather than erase history.", "mutations": [{ "target": "candidate", "type": "set", "path": "state_machine.silent_overwrite_allowed", "value": true }] },
    { "id": "reject-unbounded-context", "expected": "FAIL", "critique": "Context collection must remain minimum necessary.", "mutations": [{ "target": "candidate", "type": "set", "path": "context.minimum_necessary", "value": false }] },
    { "id": "reject-context-without-cutoff", "expected": "FAIL", "critique": "A query and cutoff are required to reproduce the evidence packet.", "mutations": [{ "target": "candidate", "type": "set", "path": "context.query_and_cutoff_required", "value": false }] },
    { "id": "reject-access-as-consent", "expected": "FAIL", "critique": "Readable material does not grant processing or publication consent.", "mutations": [{ "target": "candidate", "type": "set", "path": "context.access_equals_consent", "value": true }] },
    { "id": "reject-unbound-submitted-bytes", "expected": "FAIL", "critique": "The workflow must record exactly which bytes reached the adapter.", "mutations": [{ "target": "candidate", "type": "set", "path": "provider_adapter.exact_submitted_byte_identity_required", "value": false }] },
    { "id": "reject-provider-credentials-in-artifacts", "expected": "FAIL", "critique": "Credentials stay in the authentication environment, not workflow records.", "mutations": [{ "target": "candidate", "type": "set", "path": "provider_adapter.credentials_in_artifacts", "value": true }] },
    { "id": "reject-speaker-label-fact", "expected": "FAIL", "critique": "Machine diarization remains a candidate.", "mutations": [{ "target": "candidate", "type": "set", "path": "diarization.labels_are_candidates", "value": false }] },
    { "id": "reject-speaker-without-evidence", "expected": "FAIL", "critique": "Identity requires evidence beyond a provider label.", "mutations": [{ "target": "candidate", "type": "set", "path": "diarization.identity_requires_evidence", "value": false }] },
    { "id": "reject-roster-as-speech-proof", "expected": "FAIL", "critique": "An invitee list does not prove who spoke.", "mutations": [{ "target": "candidate", "type": "set", "path": "diarization.participant_roster_proves_speech", "value": true }] },
    { "id": "reject-no-speaker-review", "expected": "FAIL", "critique": "Speaker identity and boundaries require human review.", "mutations": [{ "target": "candidate", "type": "set", "path": "diarization.human_review_required", "value": false }] },
    { "id": "reject-invented-inaudible-speech", "expected": "FAIL", "critique": "Use an uncertainty marker rather than invent missing words.", "mutations": [{ "target": "candidate", "type": "set", "path": "repair.inaudible_reconstruction_allowed", "value": true }] },
    { "id": "reject-incomplete-private-repair", "expected": "FAIL", "critique": "A bounded projection cannot replace the complete private working record.", "mutations": [{ "target": "candidate", "type": "set", "path": "repair.complete_private_repair_required", "value": false }] },
    { "id": "reject-lost-uncertainty", "expected": "FAIL", "critique": "Repair must preserve unresolved audio and attribution uncertainty.", "mutations": [{ "target": "candidate", "type": "set", "path": "repair.uncertainty_markers_required", "value": false }] },
    { "id": "reject-reading-before-accepted-repair", "expected": "FAIL", "critique": "Close reading cannot harden an unaccepted repair into meaning.", "mutations": [{ "target": "candidate", "type": "set", "path": "close_reading.accepted_repair_required", "value": false }] },
    { "id": "reject-uncited-reading", "expected": "FAIL", "critique": "Interpretation must cite the transcript evidence it depends on.", "mutations": [{ "target": "candidate", "type": "set", "path": "close_reading.transcript_citations_required", "value": false }] },
    { "id": "reject-machine-action-acceptance", "expected": "FAIL", "critique": "Extraction cannot accept work for a person or group.", "mutations": [{ "target": "candidate", "type": "set", "path": "close_reading.machine_actions_accepted_automatically", "value": true }] },
    { "id": "reject-graph-auto-promotion", "expected": "FAIL", "critique": "The graph stage produces a review candidate only.", "mutations": [{ "target": "candidate", "type": "set", "path": "projection.automatic_graph_promotion", "value": true }] },
    { "id": "reject-public-default-projection", "expected": "FAIL", "critique": "Public use belongs to a separate governance workflow.", "mutations": [{ "target": "candidate", "type": "set", "path": "projection.public_projection_in_scope", "value": true }] },
    { "id": "reject-assignment-inference", "expected": "FAIL", "critique": "Discussed or extracted action does not establish acceptance.", "mutations": [{ "target": "candidate", "type": "set", "path": "projection.accepted_assignment_inferred", "value": true }] },
    { "id": "reject-raw-audio-in-public-git", "expected": "FAIL", "critique": "The public repository cannot hold private source audio.", "mutations": [{ "target": "candidate", "type": "set", "path": "public_boundary.raw_audio_in_public_git", "value": true }] },
    { "id": "reject-public-runtime-private-dependency", "expected": "FAIL", "critique": "The public build must remain independent of permissioned infrastructure.", "mutations": [{ "target": "candidate", "type": "set", "path": "public_boundary.private_runtime_dependency", "value": true }] },
    { "id": "reject-upload-without-artifact-authorization", "expected": "FAIL", "critique": "Authentication alone does not authorize an upload.", "mutations": [{ "target": "candidate", "type": "set", "path": "automation.upload_without_artifact_authorization", "value": true }] },
    { "id": "reject-automated-publication", "expected": "FAIL", "critique": "Automation cannot publish private-derived material.", "mutations": [{ "target": "candidate", "type": "set", "path": "automation.publish", "value": true }] },
    { "id": "reject-automated-assignment", "expected": "FAIL", "critique": "Automation cannot assign work or organizational commitments.", "mutations": [{ "target": "candidate", "type": "set", "path": "automation.assign_work", "value": true }] },
    { "id": "reject-human-gate-loss", "expected": "FAIL", "critique": "Speaker-and-repair acceptance cannot be replaced by automation.", "mutations": [{ "target": "candidate", "type": "set", "path": "human_gates.2", "value": "automated-repair-acceptance" }] }
  ]
}
