{
  "id": "knowledge-wiki-foundation",
  "version": 2,
  "profile": "foundation_ready",
  "principle": "Markdown is the record, the graph is compiled, and the portfolio is a governed projection.",
  "stopRule": {
    "consecutivePasses": 2,
    "requireUnchangedCandidate": true,
    "requireIndependentJudgments": [
      "architecture-editorial",
      "systems-public-safety"
    ]
  },
  "hardGates": [
    "authority_documented",
    "wiki_integrity",
    "canonical_reference_integrity",
    "generated_artifacts_current",
    "graph_determinism",
    "discoverability",
    "query_benchmark",
    "mutation_rejection",
    "archive_population_closure",
    "archive_disposition_governance",
    "archive_public_safety",
    "archive_collective_credit",
    "archive_application_value",
    "archive_projection_restraint",
    "missing_page_governance",
    "source_reencounter_practice",
    "source_grounded_page_creation",
    "inquiry_integrity",
    "projection_restraint",
    "candidate_binding"
  ],
  "diagnostics": [
    "records_by_kind",
    "typed_relations",
    "prose_links",
    "root_distance",
    "type_aware_orphans",
    "dead_ends",
    "wanted_pages",
    "rights_backlog",
    "human_review_backlog"
  ],
  "queryBenchmarks": [
    {
      "id": "callnyc-project",
      "query": { "id": "project.callnyc" },
      "expectedRecordIds": ["project.callnyc"],
      "requiredBoundary": "It was not an official Council product"
    },
    {
      "id": "callnyc-date-source",
      "query": { "canonicalRef": "SRC-CALLNYC-CIVIC-HALL-POST-693124020917522433" },
      "expectedRecordIds": ["source.civichall.hackathon-announcement.2016"],
      "requiredBoundary": "does not establish a dedicated Civic Hall calendar page"
    },
    {
      "id": "callnyc-projection",
      "query": { "surface": "/work/callnyc" },
      "expectedRecordIds": [
        "claim.callnyc.hackathon-date-time",
        "claim.callnyc.independent-follow-on",
        "portfolio.work.callnyc",
        "project.callnyc"
      ],
      "requiredBoundary": "not a mirror of the Wiki"
    },
    {
      "id": "digital-district-rights",
      "query": { "id": "asset.photo.digital-district.001" },
      "expectedRecordIds": ["asset.photo.digital-district.001"],
      "requiredBoundary": "Evidentiary value does not confer publication permission."
    },
    {
      "id": "chronology-correction",
      "query": { "id": "correction.callnyc-years" },
      "expectedRecordIds": ["correction.callnyc-years"],
      "requiredBoundary": "Consequential history remains visible"
    },
    {
      "id": "nycartc-shared-folder-run",
      "query": { "id": "research-run.nycartc.shared-folder.2026-07" },
      "expectedRecordIds": ["research-run.nycartc.shared-folder.2026-07"],
      "requiredBoundary": "Completeness here means complete accounting and governance"
    },
    {
      "id": "nycartc-shared-folder-census",
      "query": { "canonicalRef": "SRC-NYCARTC-SHARED-FOLDER-CENSUS-2026" },
      "expectedRecordIds": [
        "research-run.nycartc.shared-folder.2026-07",
        "source.nycartc.shared-folder-census.2026"
      ],
      "requiredBoundary": "It does not establish authorship, rights, content-level review of every file"
    },
    {
      "id": "nycartc-march-data-design-boundary",
      "query": { "id": "claim.nycartc.march-data-design-lead" },
      "expectedRecordIds": ["claim.nycartc.march-data-design-lead"],
      "requiredBoundary": "cannot allocate the complete design passage to Jamie"
    },
    {
      "id": "missing-pages-governance",
      "query": { "id": "index.knowledge-wiki-missing-pages" },
      "expectedRecordIds": ["index.knowledge-wiki-missing-pages"],
      "requiredBoundary": "Full access authorization makes research possible. It does not make protected material public"
    },
    {
      "id": "source-reencounter-method",
      "query": { "id": "method.source-re-encounter" },
      "expectedRecordIds": ["method.source-re-encounter"],
      "requiredBoundary": "located and read must remain separate states"
    },
    {
      "id": "nycartc-participation-method",
      "query": { "id": "method.nycartc.public-meeting-and-testimony-participation" },
      "expectedRecordIds": ["method.nycartc.public-meeting-and-testimony-participation"],
      "requiredBoundary": "The evidence remains collective"
    },
    {
      "id": "nycartc-nightlife-timeline",
      "query": { "id": "timeline.nycartc.nightlife-recommendations.2017-2019" },
      "expectedRecordIds": ["timeline.nycartc.nightlife-recommendations.2017-2019"],
      "requiredBoundary": "not a complete campaign chronology"
    },
    {
      "id": "nycartc-march-attribution-inquiry",
      "query": { "id": "inquiry.nycartc.march-data-design-attribution" },
      "expectedRecordIds": ["inquiry.nycartc.march-data-design-attribution"],
      "requiredBoundary": "does not establish complete authorship, implementation, validation, safety, adoption, or causal impact"
    }
  ],
  "humanTasks": [
    {
      "id": "find-callnyc-chronology",
      "prompt": "Find the current CallNYC chronology and explain why the project is dated 2016.",
      "expectedRecordIds": ["project.callnyc", "correction.callnyc-years"],
      "requiredBoundary": "Do not describe CallNYC as an official hackathon project."
    },
    {
      "id": "find-event-window",
      "prompt": "Find the source supporting the January 30, 2016, 1-3 p.m. event window.",
      "expectedRecordIds": ["source.civichall.hackathon-announcement.2016"],
      "requiredBoundary": "A participant photograph timestamp is not the event start time."
    },
    {
      "id": "find-digital-district-boundary",
      "prompt": "Explain what the Digital District photograph supports and whether it may be published.",
      "expectedRecordIds": ["asset.photo.digital-district.001"],
      "requiredBoundary": "Rights and consent remain human-blocked."
    },
    {
      "id": "find-role-proof",
      "prompt": "Find one project demonstrating public-data translation for a Technical Operations reader.",
      "expectedRecordIds": ["capability.technical-operations", "project.callnyc"],
      "requiredBoundary": "The capability path does not retroactively assign a formal job title."
    },
    {
      "id": "find-projection-restraint",
      "prompt": "Show why the portfolio page is smaller than the underlying Wiki record.",
      "expectedRecordIds": ["portfolio.work.callnyc", "project.callnyc"],
      "requiredBoundary": "Mature knowledge can remain unselected."
    },
    {
      "id": "find-nycartc-operating-system",
      "prompt": "Explain how the NYC Artist Coalition shared archive strengthens Jamie's Technical Operations story without assigning him collective work.",
      "expectedRecordIds": [
        "capability.technical-operations",
        "project.nyc-artist-coalition",
        "claim.nycartc.public-meeting-operating-system",
        "research-run.nycartc.shared-folder.2026-07"
      ],
      "requiredBoundary": "Do not infer authorship or individual task ownership from Drive metadata."
    },
    {
      "id": "find-missing-pages",
      "prompt": "What missing Knowledge Wiki pages matter most, which were created, and which remain deferred or protected?",
      "expectedRecordIds": [
        "index.knowledge-wiki-missing-pages",
        "method.source-re-encounter",
        "method.nycartc.public-meeting-and-testimony-participation",
        "timeline.nycartc.nightlife-recommendations.2017-2019",
        "inquiry.nycartc.march-data-design-attribution"
      ],
      "requiredBoundary": "A wanted page is not complete merely because an agent can locate a source."
    },
    {
      "id": "find-source-reencounter-practice",
      "prompt": "Explain how an agent should return to original source material and what to do when the current access method fails.",
      "expectedRecordIds": [
        "method.source-re-encounter",
        "research-run.nycartc.shared-folder.2026-07"
      ],
      "requiredBoundary": "Research authorization is not publication permission."
    },
    {
      "id": "find-participation-design",
      "prompt": "Show how NYC Artist Coalition supported both meeting production and participant testimony without assigning the collective system to Jamie.",
      "expectedRecordIds": [
        "method.nycartc.public-meeting-and-testimony-participation",
        "source.nycartc.public-meeting-playbook.2018",
        "source.nycartc.testimony-guide.2017"
      ],
      "requiredBoundary": "Do not infer authorship, task ownership, usage totals, attendance, or policy impact."
    },
    {
      "id": "find-march-attribution-inquiry",
      "prompt": "What does the present MARCH source encounter attribute directly to Jamie, and what remains unresolved?",
      "expectedRecordIds": [
        "inquiry.nycartc.march-data-design-attribution",
        "claim.nycartc.march-data-design-lead",
        "source.nycartc.march-data-design-notes.2019"
      ],
      "requiredBoundary": "A narrow attributed suggestion does not establish complete design authorship or implementation."
    }
  ],
  "manualAuthorityGates": [
    "human_navigation_study",
    "collaborator_consent",
    "rights_clearance",
    "editorial_approval",
    "production_observation"
  ]
}
