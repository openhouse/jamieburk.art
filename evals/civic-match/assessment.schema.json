{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["personId", "kind", "acceptanceQuestion", "pass", "strengths", "risks", "followUp", "narrative"],
  "properties": {
    "personId": {"type": "string", "pattern": "^person\\."},
    "kind": {"type": "string", "enum": ["hiring-reader", "civic-match-helper"]},
    "acceptanceQuestion": {"type": "string", "minLength": 20},
    "pass": {"type": "boolean"},
    "strengths": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 10}},
    "risks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 10}},
    "followUp": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 10}},
    "narrative": {"type": "string", "minLength": 30}
  }
}
