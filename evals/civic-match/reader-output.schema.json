{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "guideSha256",
    "decision",
    "acceptance",
    "strengths",
    "risks",
    "followUpEvidence",
    "rationale"
  ],
  "properties": {
    "guideSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "decision": {"type": "string", "enum": ["pass", "fail"]},
    "acceptance": {"type": "boolean"},
    "strengths": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "risks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "followUpEvidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "rationale": {"type": "string", "minLength": 80}
  }
}
