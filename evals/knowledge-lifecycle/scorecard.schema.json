{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge lifecycle scorecard",
  "type": "object",
  "additionalProperties": false,
  "required": ["evalId", "evaluatedAt", "evaluator", "revision", "artifactsReviewed", "criteria", "releaseRecommendation"],
  "properties": {
    "evalId": { "type": "string", "const": "knowledge-lifecycle-v1" },
    "evaluatedAt": { "type": "string" },
    "evaluator": { "type": "string", "minLength": 1 },
    "revision": { "type": "string", "minLength": 1 },
    "artifactsReviewed": { "type": "array", "minItems": 6, "items": { "type": "string" } },
    "criteria": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "score", "confidence", "evidence", "mostImportantFailure", "repair", "repairLayer", "antiGamingCheck"],
        "properties": {
          "id": { "enum": ["intake-preservation", "source-decomposition", "research-posture", "promotion-governance", "editorial-composability", "media-feedback"] },
          "score": { "type": "integer", "minimum": 1, "maximum": 5 },
          "confidence": { "enum": ["low", "medium", "high"] },
          "evidence": { "type": "array", "minItems": 3, "items": { "type": "string" } },
          "mostImportantFailure": { "type": ["string", "null"] },
          "repair": { "type": "string", "minLength": 1 },
          "repairLayer": { "type": "array", "minItems": 1, "items": { "enum": ["schema", "content", "research", "governance", "projection", "media", "tests", "human-review", "none"] } },
          "antiGamingCheck": { "type": "string", "minLength": 1 }
        }
      }
    },
    "releaseRecommendation": { "enum": ["iterate", "framework-ready"] }
  }
}
