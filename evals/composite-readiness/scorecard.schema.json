{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Composite readiness scorecard",
  "type": "object",
  "additionalProperties": false,
  "required": ["evalId", "evaluatedAt", "evaluator", "revision", "pagesReviewed", "criteria", "releaseRecommendation"],
  "properties": {
    "evalId": { "type": "string", "const": "composite-readiness-v1" },
    "evaluatedAt": { "type": "string" },
    "evaluator": { "type": "string", "minLength": 3 },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "pagesReviewed": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "criteria": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "score", "confidence", "evidence", "mostImportantFailure", "repair", "repairLayer", "antiGamingCheck"],
        "properties": {
          "id": {
            "type": "string",
            "enum": ["CR-001", "CR-002", "CR-003", "CR-004", "CR-005", "CR-006", "CR-007", "CR-008", "CR-009", "CR-010", "CR-011", "CR-012", "CR-013", "CR-014"]
          },
          "score": { "type": "integer", "minimum": 1, "maximum": 5 },
          "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
          "evidence": {
            "type": "array",
            "minItems": 3,
            "items": { "type": "string", "minLength": 3 }
          },
          "mostImportantFailure": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "repair": { "type": "string", "minLength": 3 },
          "repairLayer": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["integration", "knowledge-bank", "website", "artifact", "infrastructure", "human-approval", "external-evidence", "none"]
            }
          },
          "antiGamingCheck": { "type": "string", "minLength": 3 }
        }
      }
    },
    "releaseRecommendation": {
      "type": "string",
      "enum": ["iterate", "framework-ready", "application-ready"]
    }
  }
}

