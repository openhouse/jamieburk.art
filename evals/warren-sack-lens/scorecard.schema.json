{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prof Warren Sack Lens scorecard",
  "type": "object",
  "additionalProperties": false,
  "required": ["evalId", "evaluatedAt", "evaluator", "revision", "pagesReviewed", "criteria", "releaseRecommendation"],
  "properties": {
    "evalId": { "type": "string", "const": "warren-sack-lens-v1" },
    "evaluatedAt": { "type": "string" },
    "evaluator": { "type": "string", "minLength": 1 },
    "revision": { "type": "string", "minLength": 1 },
    "pagesReviewed": { "type": "array", "minItems": 6, "items": { "type": "string" } },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "score", "confidence", "dimensionFindings", "evidence", "mostImportantFailure", "repair", "repairLayer", "antiGamingCheck"],
        "properties": {
          "id": { "type": "string", "const": "warren-sack-lens" },
          "score": { "type": "integer", "minimum": 1, "maximum": 5 },
          "confidence": { "enum": ["low", "medium", "high"] },
          "dimensionFindings": {
            "type": "object",
            "additionalProperties": false,
            "required": ["recursiveSocialInference", "theoryToPrototype", "interfaceForAction", "situatedLearning", "sourceBackedReasoning", "collectiveArchitecture", "continuityAcrossTime"],
            "properties": {
              "recursiveSocialInference": { "type": "string", "minLength": 1 },
              "theoryToPrototype": { "type": "string", "minLength": 1 },
              "interfaceForAction": { "type": "string", "minLength": 1 },
              "situatedLearning": { "type": "string", "minLength": 1 },
              "sourceBackedReasoning": { "type": "string", "minLength": 1 },
              "collectiveArchitecture": { "type": "string", "minLength": 1 },
              "continuityAcrossTime": { "type": "string", "minLength": 1 }
            }
          },
          "evidence": { "type": "array", "minItems": 6, "items": { "type": "string" } },
          "mostImportantFailure": { "type": ["string", "null"] },
          "repair": { "type": "string", "minLength": 1 },
          "repairLayer": { "type": "array", "minItems": 1, "items": { "enum": ["knowledge-bank", "website", "artifact", "infrastructure", "human-approval", "none"] } },
          "antiGamingCheck": { "type": "string", "minLength": 1 }
        }
      }
    },
    "releaseRecommendation": { "enum": ["iterate", "criterion-met"] }
  }
}
